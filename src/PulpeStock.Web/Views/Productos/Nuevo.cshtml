@model DatosProducto
@{
    ViewData["Title"] = "Nuevo producto";
}
<a class="volver" asp-action="Index">Volver a productos</a>
<h1>Nuevo producto</h1>
<form class="tarjeta formulario" asp-action="Nuevo" method="post">
    <partial name="_DatosProducto" model="Model" />
    <div class="acciones">
        <button class="boton" type="submit">Guardar producto</button>
        <a asp-action="Index">Cancelar</a>
    </div>
</form>
