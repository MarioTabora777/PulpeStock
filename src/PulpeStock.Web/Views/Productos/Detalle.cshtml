@model DetalleProducto
@{
    var producto = Model.Producto;
    var ultimo = Model.Conteos.FirstOrDefault();
    ViewData["Title"] = producto.Nombre;
}
<a class="volver" asp-action="Index">Volver a productos</a>

<header class="encabezado">
    <div>
        <h1>@producto.Nombre</h1>
        <p class="detalle">@producto.Marca · @producto.Presentacion</p>
        @if (producto.CodigoBarras is not null)
        {
            <p class="detalle">Código de barras @producto.CodigoBarras</p>
        }
    </div>
    <div class="acciones">
        <a asp-action="Editar" asp-route-id="@producto.Id">Editar producto</a>
        @if (producto.Activo)
        {
            <a class="boton" asp-action="Contar" asp-route-id="@producto.Id">Registrar conteo</a>
        }
    </div>
</header>

<section class="tarjeta resumen" aria-labelledby="estado-producto">
    <h2 id="estado-producto">Estado del producto</h2>
    <p>@(producto.Activo ? "Activo" : "Inactivo")</p>
    <form asp-action="@(producto.Activo ? "Desactivar" : "Reactivar")" asp-route-id="@producto.Id" method="post">
        <button class="boton-secundario" type="submit">@(producto.Activo ? "Desactivar producto" : "Reactivar producto")</button>
    </form>
</section>

<section class="tarjeta resumen historial" aria-labelledby="ultimo-conteo">
    <h2 id="ultimo-conteo">Último conteo</h2>
    @if (ultimo is null)
    {
        <p>Sin conteo</p>
    }
    else
    {
        <p class="cantidad">@ultimo.TotalUnidades <span>unidades</span></p>
        <time datetime="@FechaConteo.EnIsoUtc(ultimo.FechaUtc)">@FechaConteo.EnHoraLocal(ultimo.FechaUtc)</time>
    }
</section>

<section class="tarjeta resumen historial" aria-labelledby="minimo-producto">
    <h2 id="minimo-producto">Mínimo para reposición</h2>
    @if (producto.ExistenciaMinima is int minimo)
    {
        <p>@minimo unidades</p>
        @if (producto.Activo && ultimo is not null && ultimo.TotalUnidades <= minimo)
        {
            <p>Por reponer según el último conteo.</p>
        }
    }
    else
    {
        <p>Sin mínimo configurado</p>
    }
    <a asp-controller="Reposicion" asp-action="Minimo" asp-route-id="@producto.Id">Configurar mínimo</a>
</section>

@if (Model.Conteos.Count > 0)
{
    <section class="historial" aria-labelledby="historial-conteos">
        <h2 id="historial-conteos">Historial de conteos</h2>
        <div class="tarjeta tabla-contenedor">
            <table>
                <thead>
                    <tr>
                        <th scope="col">Fecha</th>
                        <th scope="col">Total</th>
                        <th scope="col">Desglose</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var conteo in Model.Conteos)
                    {
                        <tr>
                            <td><time datetime="@FechaConteo.EnIsoUtc(conteo.FechaUtc)">@FechaConteo.EnHoraLocal(conteo.FechaUtc)</time></td>
                            <td>@conteo.TotalUnidades</td>
                            <td>
                                <span>@conteo.UnidadesSueltas unidades sueltas</span>
                                @foreach (var paquete in conteo.Paquetes)
                                {
                                    <span class="detalle">@paquete.Cantidad × @paquete.UnidadesPorPaquete unidades por paquete</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}
