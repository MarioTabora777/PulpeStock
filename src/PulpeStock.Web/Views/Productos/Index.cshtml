@model ListadoProductos
@{
    ViewData["Title"] = "Productos";
}
<header class="encabezado">
    <h1>Productos</h1>
    <a class="boton" asp-action="Nuevo">Nuevo producto</a>
</header>

<form class="tarjeta formulario filtros" asp-action="Index" method="get">
    <div class="campo">
        <label asp-for="Estado"></label>
        <select asp-for="Estado" asp-items="Html.GetEnumSelectList<EstadoProductos>()"></select>
        <span asp-validation-for="Estado" class="errores"></span>
    </div>
    <button class="boton" type="submit">Consultar</button>
</form>

@if (ViewData.ModelState.IsValid && Model.Productos.Count == 0)
{
    <p class="tarjeta vacio">No hay productos para el estado seleccionado.</p>
}
else if (ViewData.ModelState.IsValid)
{
    <div class="tarjeta tabla-contenedor">
        <table>
            <thead>
                <tr>
                    <th scope="col">Producto</th>
                    <th scope="col">Último conteo</th>
                    <th scope="col">Fecha del conteo</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var producto in Model.Productos)
                {
                    <tr data-producto="@producto.Id">
                        <th scope="row">
                            <a asp-action="Detalle" asp-route-id="@producto.Id">@producto.Nombre</a>
                            <span class="detalle">@producto.Marca · @producto.Presentacion</span>
                            @if (!producto.Activo)
                            {
                                <span class="detalle">Inactivo</span>
                            }
                        </th>
                        <td>
                            @if (producto.UltimoTotal is int total)
                            {
                                @($"{total} unidades")
                            }
                            else
                            {
                                <span class="atenuado">Sin conteo</span>
                            }
                        </td>
                        <td>
                            @if (producto.UltimaFechaUtc is DateTime fecha)
                            {
                                <time datetime="@FechaConteo.EnIsoUtc(fecha)">@FechaConteo.EnHoraLocal(fecha)</time>
                            }
                            else
                            {
                                <span aria-label="Sin fecha">—</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
