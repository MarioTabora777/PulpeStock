@model ReporteInventario
@{
    ViewData["Title"] = "Reporte de inventario";
}
<header class="encabezado">
    <div>
        <h1>Reporte de inventario</h1>
        <p class="detalle">Última cantidad contada por producto, con la fecha de la revisión.</p>
    </div>
    <div class="acciones">
        <a asp-action="Historial">Historial de conteos</a>
        <a asp-action="Reposicion">Reporte de reposición</a>
    </div>
</header>

<form class="tarjeta formulario filtros" asp-action="Index" method="get">
    <div class="campo">
        <label asp-for="ProductoId"></label>
        <select asp-for="ProductoId" asp-items="Model.Opciones">
            <option value="">Todos los productos</option>
        </select>
        <span asp-validation-for="ProductoId" class="errores"></span>
    </div>
    <div class="acciones">
        <button class="boton" type="submit">Consultar</button>
        <button class="boton-secundario" type="submit" name="descargar" value="true">Descargar CSV</button>
        <a asp-action="Index">Limpiar filtro</a>
    </div>
</form>

@if (ViewData.ModelState.IsValid)
{
    @if (Model.Productos.Count == 0)
    {
        <p class="tarjeta vacio">Todavía no hay productos registrados.</p>
    }
    else
    {
        <div class="tarjeta tabla-contenedor">
            <table>
                <thead>
                    <tr><th scope="col">Producto</th><th scope="col">Último conteo</th><th scope="col">Fecha del conteo</th></tr>
                </thead>
                <tbody>
                    @foreach (var producto in Model.Productos)
                    {
                        <tr data-producto="@producto.Id">
                            <th scope="row">
                                <a asp-controller="Productos" asp-action="Detalle" asp-route-id="@producto.Id">@producto.Nombre</a>
                                <span class="detalle">@producto.Marca · @producto.Presentacion</span>
                                @if (!producto.Activo)
                                {
                                    <span class="detalle">Inactivo</span>
                                }
                            </th>
                            <td>
                                @if (producto.UltimoTotal is int total)
                                {
                                    @($"{total} unidades")
                                }
                                else
                                {
                                    <span class="atenuado">Sin conteo</span>
                                }
                            </td>
                            <td>
                                @if (producto.UltimaFechaUtc is DateTime fecha)
                                {
                                    <time datetime="@FechaConteo.EnIsoUtc(fecha)">@FechaConteo.EnHoraLocal(fecha)</time>
                                }
                                else
                                {
                                    <span aria-label="Sin fecha">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
