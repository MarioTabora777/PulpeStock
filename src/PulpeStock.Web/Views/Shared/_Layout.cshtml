<!DOCTYPE html>
<html lang="es-HN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · PulpeStock</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="cabecera">
        <nav class="contenedor navegacion" aria-label="Principal">
            <a class="nombre-app" asp-controller="Productos" asp-action="Index">PulpeStock</a>
            <a asp-controller="Productos" asp-action="Index">Productos</a>
            <a asp-controller="Reposicion" asp-action="Index">Reposición</a>
        </nav>
    </header>
    <main class="contenedor contenido">
        @RenderBody()
    </main>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
